# Copy this file to backend/.env and fill in your own values. Never commit .env.

# Qdrant vector database: a Qdrant Cloud cluster URL, or http://localhost:6333 for a local instance
QDRANT_URL=http://localhost:6333
# Qdrant Cloud API key (leave empty for a local instance without authentication)
QDRANT_API_KEY=

# Nomic API key for nomic-embed-text-v1 embeddings (https://atlas.nomic.ai)
NOMIC_API_KEY=

# Hugging Face access token with access granted to meta-llama/Llama-2-7b-chat-hf
HF_TOKEN=
