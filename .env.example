# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or a local server)
MONGODB_URI=mongodb://localhost:27017/intellidatum

# Secret used to sign login tokens (JWT) - use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Base URL of the Python processing service in backend/ (no trailing slash)
BACKEND_API=http://localhost:5000

# Gmail account that emails password-reset codes. Use a Google App Password,
# not the account's normal password (https://support.google.com/accounts/answer/185833)
EMAIL_ID=
EMAIL_PASSWORD=

# EmailJS - powers the Contact Us form (https://dashboard.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
